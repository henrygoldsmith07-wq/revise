# AI provider - any OpenAI-compatible endpoint. Shown configured for NVIDIAs
# integrate.api.nvidia.com; keys live ONLY in .env.local (gitignored).
# Swap base URL/key to https://openrouter.ai/api/v1 + sk-or-v1-... for OpenRouter.
AI_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_COMPATIBLE_API_KEY=nvapi-your-key-here
# Primary must appear in OPENAI_COMPATIBLE_MODELS. The list is
# INTELLIGENCE-RANKED (smartest first); failures rotate down it up to
# OPENAI_COMPATIBLE_MAX_ROTATIONS models deep before the offline fallback.
# Image-bearing requests (OCR/handwriting) prefer vision-capable entries.
OPENAI_COMPATIBLE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENAI_COMPATIBLE_MAX_ROTATIONS=8
OPENAI_COMPATIBLE_MODELS=nvidia/nemotron-3-ultra-550b-a55b,google/gemma-4-31b-it,nvidia/nemotron-3-super-120b-a12b,thinkingmachines/inkling,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3-nano-30b-a3b,nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-nano-12b-v2-vl,nvidia/nvidia-nemotron-nano-9b-v2,poolside/laguna-xs-2.1,nvidia/nemotron-3.5-content-safety

# --- AI rate limiting -----------------------------------------------------
# Local development uses the in-memory bucket (no setup). Production with
# several instances must set RATE_LIMIT_BACKEND=supabase so per-user quotas
# (burst + per-minute + daily, weighted by task) hold across instances via
# the consume_ai_quota RPC in supabase/schema.sql. When shared limiting is
# requested but unavailable, /api/ai fails closed with 503 rather than
# silently downgrading to per-instance quotas.
# RATE_LIMIT_BACKEND=memory
# Daily AI cost-units per user (default 500 when unset).
# AI_DAILY_LIMIT=500

# --- Post-marking error diagnosis (classifier.dev) --------------------------
# classifier.dev is a keyless, zero-shot text classifier. Revise uses it for
# ONE job: after marking, deciding *why* a dropped mark was lost so the right
# intervention follows (misconception → targeted explanation, calculation →
# worked scaffold, terminology → definition recall, command-word → exam
# technique, knowledge-gap → content retrieval).
#
# It never marks. awarded/max are fixed by the mark scheme before it is called,
# and a low-confidence answer is recorded as `other` rather than acted on.
# Set CLASSIFIER_DISABLED=1 to force the deterministic local classifier always
# — useful offline, in CI, and for a strict no-third-party-text policy.
# CLASSIFIER_DISABLED=1

# --- OpenRouter free tier (video-style lessons) -----------------------------
# The video-lesson task storyboard runs on whatever free OpenRouter model is
# reachable. MiniMax M3 free is a valid primary, but an account's privacy
# guardrails (https://openrouter.ai/settings/privacy) can 404 its endpoints —
# keep reachable free models later in the chain so rotation covers it.
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_MODEL=minimax/minimax-m3:free
# OPENAI_COMPATIBLE_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3.5-lightning:free,liquid/lfm-2.5-2.6b:free
# OPENAI_COMPATIBLE_MAX_ROTATIONS=5
