{
  "initialRoute": {
    "maxBytes": 3200000,
    "maxGzipBytes": 950000,
    "manifestRoute": "/"
  },
  "routes": {
    "/": {
      "maxBytes": 5400000,
      "maxGzipBytes": 1420000,
      "note": "Root files plus the layout and page entry chunks for /. Measured 2026-10-12: 5,124,216 raw / 1,351,190 gzip (the content bank chunk is ~3.6 MB of it). Lower these as the bank leaves the boot path; never raise them to fit a regression."
    }
  },
  "optionalChunks": {
    "pdfjs-dist": { "maxBytes": 2500000, "maxGzipBytes": 800000 },
    "@huggingface/transformers": { "maxBytes": 8000000, "maxGzipBytes": 2500000 },
    "@mlc-ai/web-llm": { "maxBytes": 8000000, "maxGzipBytes": 2500000 },
    "onnxruntime": { "maxBytes": 8000000, "maxGzipBytes": 2500000 },
    "tesseract.js": { "maxBytes": 4000000, "maxGzipBytes": 1200000 },
    "katex": { "maxBytes": 600000, "maxGzipBytes": 220000 }
  },
  "forbiddenInitialImports": [
    "pdfjs-dist",
    "@huggingface/transformers",
    "@mlc-ai/web-llm",
    "webllm",
    "onnxruntime",
    "tesseract.js"
  ]
}

