{
  "name": "revise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint:check --silent && npm run type-check && npm run type-check:strict && node scripts/validate-curriculum.mjs && npm run curriculum:freshness -- --fail-on-stale && npm run content:check && npm run docs:integrity --silent && npm run wjec:authoring:check --silent && npm run wjec:trust:check --silent && npm run wjec:supply:check --silent && npm run wjec:review:gates --silent && npm test -- --run && npm run build && npm run perf:budget",
    "perf:budget": "node scripts/check-client-performance.mjs --require-build",
    "docs:integrity": "node scripts/check-docs-integrity.mjs",
    "content:capacitors": "node scripts/generate-content.mjs capacitors",
    "perf:physics-bank": "node scripts/benchmark-physics-bank.mjs",
    "curriculum:freshness": "node scripts/check-curriculum-freshness.mjs",
    "physics:evidence:init": "node scripts/create-physics-evidence-intake.mjs",
    "physics:evidence:check": "node scripts/validate-physics-evidence.mjs",
    "wjec:review:export": "node scripts/wjec-content-review.mjs export",
    "wjec:review:batch": "node scripts/export-wjec-review-batch.mjs",
    "wjec:review:check": "node scripts/wjec-content-review.mjs check",
    "wjec:review:apply": "node scripts/apply-wjec-review-ledger.mjs",
    "wjec:prerequisite:batch": "node scripts/export-wjec-prerequisite-batch.mjs",
    "wjec:prerequisite:apply": "node scripts/apply-wjec-prerequisite-ledger.mjs",
    "wjec:coverage": "node scripts/report-trusted-coverage.mjs",
    "wjec:trust:report": "node scripts/report-flagship-trust.mjs",
    "wjec:trust:check": "node scripts/report-flagship-trust.mjs --check",
    "wjec:supply:audit": "node scripts/audit-question-supply.mjs",
    "wjec:supply:check": "node scripts/audit-question-supply.mjs --check",
    "wjec:authoring:gaps": "node scripts/report-wjec-authoring-gaps.mjs",
    "wjec:authoring:plan": "node scripts/plan-wjec-authoring.mjs",
    "wjec:authoring:refresh": "node scripts/report-wjec-authoring-gaps.mjs --write",
    "wjec:authoring:check": "node scripts/report-wjec-authoring-gaps.mjs --check",
    "wjec:release:check": "node scripts/apply-wjec-release-proposal.mjs --dry-run",
    "wjec:release:apply": "node scripts/apply-wjec-release-proposal.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/build-domain-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/build-domain-worker.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/build-domain-worker.mjs",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:ci": "playwright test --reporter=github,html",
    "test:staging": "node scripts/run-staging-tests.mjs",
    "type-check:strict": "tsc --noEmit -p tsconfig.strict.json",
    "content:physics": "node scripts/generate-structured-physics.mjs",
    "content:check": "node scripts/generate-content.mjs capacitors --check && node scripts/generate-structured-physics.mjs --check && node scripts/generate-physics-reasoning.mjs --check",
    "content:reasoning": "node scripts/generate-physics-reasoning.mjs",
    "wjec:review:priorities": "node scripts/wjec-review.mjs priorities",
    "wjec:review:queue": "node scripts/wjec-review.mjs queue",
    "wjec:review:pack": "node scripts/generate-review-pack-html.mjs",
    "wjec:review:pack:import": "node scripts/import-review-pack-html.mjs",
    "wjec:review:import": "node scripts/wjec-review.mjs import",
    "wjec:review:promote": "node scripts/wjec-review.mjs promote",
    "wjec:review:status": "node scripts/wjec-review.mjs status",
    "wjec:review:gates": "node scripts/wjec-review.mjs check",
    "wjec:quality:report": "node scripts/report-wjec-quality.mjs",
    "wjec:campaign": "node scripts/wjec-review.mjs campaign",
    "wjec:readiness": "node scripts/wjec-review.mjs readiness",
    "product:quality": "node scripts/report-product-quality.mjs",
    "marking:evidence:init": "node scripts/marking-evidence.mjs init",
    "marking:evidence:pack": "node scripts/marking-evidence.mjs pack",
    "marking:evidence:import": "node scripts/marking-evidence.mjs import",
    "marking:evidence:report": "node scripts/marking-evidence.mjs report"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "comlink": "^4.4.2",
    "idb": "^8.0.3",
    "katex": "^0.16.28",
    "lucide-react": "^1.25.0",
    "next": "16.3.6",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
